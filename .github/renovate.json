{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"baseBranchPatterns": ["main"],
	"extends": [
		"config:recommended",
		":widenPeerDependencies",
		"group:githubArtifactActions"
	],
	"labels": [],
	"packageRules": [
		{
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "1 month"
		},
		{
			"groupName": "commitlint ecosystem",
			"matchPackageNames": ["commitlint", "@commitlint/*"]
		},
		{
			"description": "Hold the Changesets CLI at 2 while the release workflow uses changesets/action@v1, which reads CLI 2 output. Move both to 3 together, with changesets/action@v2.",
			"matchPackageNames": ["@changesets/cli"],
			"allowedVersions": "<3"
		}
	],
	"rebaseWhen": "behind-base-branch",
	"reviewers": ["castastrophe"],
	"lockFileMaintenance": {
		"enabled": true,
		"extends": ["schedule:monthly"]
	}
}
