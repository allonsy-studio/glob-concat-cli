{
  "name": "glob-concat-cli",
  "version": "2.0.0",
  "description": "A concatenation tool leveraging fast-glob for CLIs",
  "license": "Apache-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "repository": {
    "type": "git",
    "url": "https://github.com/allonsy-studio/glob-concat-cli.git"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/glob-concat-cli/issues"
  },
  "type": "module",
  "module": "index.js",
  "bin": {
    "glob-concat": "./cli.js"
  },
  "scripts": {
    "changeset": "opx release add",
    "coverage": "c8 yarn test",
    "format": "opx lint --fix",
    "lint": "opx lint",
    "prepare": "husky",
    "prepublishOnly": "yarn test",
    "release": "opx release publish",
    "test": "ava",
    "version": "opx release version && yarn install --mode update-lockfile"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "concat-with-sourcemaps": "^1.1.0",
    "fast-glob": "^3.3.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@allons-y/opx-cli": "^0.2.0",
    "@allons-y/opx-lint-js": "^1.0.0",
    "@allons-y/opx-lint-json": "^0.1.0",
    "@allons-y/opx-lint-md": "^0.1.0",
    "@allons-y/opx-release": "^0.1.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "ava": "^7.0.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-package-json": "^2.8.0"
  },
  "keywords": [
    "cli",
    "concat",
    "globbing"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "ava": {
    "workerThreads": false
  },
  "funding": [
    {
      "type": "github",
      "url": " https://github.com/sponsors/castastrophe"
    },
    {
      "type": "buy-me-a-coffee",
      "url": "https://www.buymeacoffee.com/castastrophe"
    }
  ],
  "lint-staged": {
    "*.{js,json}": [
      "opx lint --fix"
    ],
    "*.{md,mdx}": [
      "opx lint --fix"
    ],
    ".github/renovate.json": [
      "yarn dlx --package renovate -- renovate-config-validator"
    ],
    "package.json": [
      "prettier-package-json --write"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
